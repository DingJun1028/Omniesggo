{
  "name": "esggo",
  "version": "5.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "bin": {
    "esggo": "./packages/cli/src/omni.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs || true",
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1536 tsx scripts/validate-env.ts 2>/dev/null || true && next build",
    "dev:vinext": "vite dev --config vite.config.mjs",
    "build:vinext": "vite build --config vite.config.mjs",
    "deploy:cloudflare": "vinext-cloudflare deploy",
    "start": "bash -c 'set -a; source .env 2>/dev/null; set +a; next start -H 0.0.0.0'",
    "lint": "ts-node scripts/celestial-gate.ts",
    "lint:full": "eslint src/ --max-warnings 50",
    "typecheck": "tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && vitest run src/impl/__tests__/core.test.ts src/agents/twelve-omni/__tests__",
    "turbo:dev": "next dev",
    "turbo:build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "turbo:start": "next start",
    "turbo:lint": "eslint . --fix",
    "oa:summon": "ts-node --transpile-only -P tsconfig.scripts.json scripts/run-summon.ts",
    "oa:summon:core": "ts-node --transpile-only -P tsconfig.scripts.json scripts/run-summon.ts -- --core",
    "oa:weekly-report": "tsx cli/oa-cli/src/index.ts weekly-report",
    "oa:audit": "tsx cli/oa-cli/src/index.ts audit --dir \"src/lib,cli/oa-cli/src\"",
    "verify:gap-matrix": "node scripts/export-shared-types.js && npx tsx scripts/verify_gap_matrix.ts",
    "verify:matrix": "node scripts/verify-terminal-origin.mjs",
    "verify:prd-matrix": "node scripts/verify-prd-matrix.mjs",
    "verify": "pnpm turbo run lint typecheck test build && pnpm -F ./apps/learning-center check:types-sync"
  },
  "dependencies": {
    "@esggo/errors": "workspace:*",
    "@esggo/shared": "workspace:*",
    "@esggo/ui": "workspace:*",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@notionhq/client": "^5.27.1",
    "@notionhq/workers": "^0.9.3",
    "@prisma/client": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/redis": "^1.39.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "exceljs": "4.4.0",
    "framer-motion": "^14.4.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^4.6.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "ollama": "^0.6.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "xss": "^1.0.15",
    "zenrows": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vinext/cloudflare": "^1.1.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "next": "^16.4.2",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.19",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vinext": "^1.2.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "11.5.2"
  },
  "omnilules": {
    "enabled": true,
    "agents": [
      "omni-agent",
      "jules",
      "antigravity",
      "omninexus"
    ],
    "skills": [
      "omni-sync-memory",
      "omni-tag",
      "omni-base",
      "omni-seed",
      "omni-agent",
      "omni-write",
      "omni-biz",
      "omni-memory"
    ],
    "protocols": [
      "5t-protocol"
    ]
  },
  "resolutions": {
    "undici": "^7.29.1",
    "ip-address": "^10.7.1",
    "js-yaml": "^5.4.1",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.10",
    "next": "^16.3.8",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.4.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.18.0",
    "fast-xml-parser": "^4.5.3",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.2"
  },
  "overrides": {
    "undici": "^7.29.1",
    "ip-address": "^10.7.1",
    "js-yaml": "^5.4.1",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.10",
    "next": "^16.3.8",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.4.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.18.0",
    "fast-xml-parser": "^4.5.3",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.2"
  }
}
