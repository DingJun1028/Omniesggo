# ============================================
# Omniesggo 環境變數模板（不含實際值）
# 請複製為 .env.local 並填入真實值
# 此檔案已加入 .gitignore，不會被版本控制
# ============================================

# ============================================
# 核心 API 憑證
# ============================================

# JunAikey 萬能元鑰
# 讀取方式：read_file(C:/Users/dingj/secret-vault/ENV20230818.env)
NCBDB_API_TOKEN=***
NCBDB_PROJECT_ID=***

# JunAikey 成長層 CLI（使用包裝器）
JUNAKEY_BACKEND=local  # local 或 auto
JUNAKEY_CLI=scripts/junaikey.mjs

# OmniMasterKey 憑證存取
OMNIMASTER_KEY=***  # 會透過 omni_get_secret() 讀取

# ============================================
# LLM / AI API
# ============================================
MISTRAL_API_KEY=***
GROQ_API_KEY=***
OPENAI_API_KEY=***
ANTHROPIC_API_KEY=***


HF_TOKEN=***


# ============================================
# 雲端服務
# ============================================
CLOUDFLARE_API_TOKEN=***
VITE_CLOUDFLARE_ACCOUNT_ID=***
VPS_HOST=***
VPS_USER=***
VPS_KEY_PATH=~/.ssh/id_ed25519

# Supabase
SUPABASE_URL=***
SUPABASE_SERVICE_ROLE_KEY=***

# Firebase


# ============================================
# 資料庫連線
# ============================================
DATABASE_URL=***  # Supabase 連線（原始 SQL）
SUPABASE_TABLE_MAP={"omni_agent":"omni_agent_schema","agent_skills":"agent_skills_schema"}  # 表名映射


# ============================================
# 開發工具
# ============================================
# Tesseract OCR
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Observatory
OBSERVATORY_API_KEY=***
OBSERVATORY_URL=***


# ============================================
# 本機開發
# ============================================
# 若要使用 OneTimeSecret 取得金鑰：
# 1. 到 https://nz.onetimesecret.com/ 建立連結
# 2. 複製連結內容到此檔案
# 3. 瀏覽器開啟連結以取得密鑰
# 4. 複製到此檔案並立即保存
# 5. 然後在腳本中讀取並立即刪除連結
# AT_ONCE_SECRET_URL=***


# ============================================
# 備註
# ============================================
# ⚠️ 絕對不要將此檔案提交到版本控制
# ⚠️ 此檔案為範例，真實值位於 .env.local（已 gitignore）
# ⚠️ 如需憑證檢查，請使用 omni_get_secret() 函數
# ============================================
