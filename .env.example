# Omniesggo 環境變數範例
# 本檔案為範例，不含真實值，請複製為 .env.local 並自行填入

# ============================================
# AI / LLM 提供者
# ============================================
# 開發階段：使用免費/低成本模型（按需開通）
MISTRAL_API_KEY=***
MISTRAL_ADMIN_KEY=***
MISTRAL_WORKFLOW_KEY=***
GROQ_API_KEY=***
# 已移除 Google Gemini 配置（2026-11-02 移除 Google 相關服務）

# ============================================
# 資料庫
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***

# ============================================
# 機密存取 (Junaikey × OmniMasterKey)
# ============================================
NCBDB_API_TOKEN=***
NCBDB_PROJECT_ID=***
OMNIMASTER_KEY=***
# 注意：不含真實值，請自行填入（已 gitignore）

# ============================================
# 雲端與部署
# ============================================
CLOUDFLARE_API_TOKEN=***
VPS_HOST=your-vps-host
VPS_USER=your-vps-user
VPS_KEY_PATH=~/.ssh/id_ed25519

# ============================================
# 其他設備
# ============================================
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 注意：本檔案為範例，不應包含真實值
# 所有真實值請移至 .env.local（本機）或 secret-vault/（生產）

# Supabase (browser client + realtime) for universal notes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***
