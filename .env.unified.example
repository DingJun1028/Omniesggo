# ============================================================
# Omniesggo 統一環境變數範例
# 注意：本檔案為範例，不應包含真實值
# 所有真實值請移至 secret-vault/（生產環境管理）
# ============================================================

# ============================================
# 應用程式與網關
# ============================================
GATEWAY_URL=http://omniagent-gateway:8642
GATEWAY_API_KEY=***

# ============================================
# 資料庫與快取
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***
REDIS_URL=redis://localhost:6379

# ============================================
# 機密存取 (Junaikey × OmniMasterKey) ★ 已輪替
# ============================================
NCBDB_API_TOKEN=***
NCBDB_PROJECT_ID=***
OMNIMASTER_KEY=***
# 機密安全：2026-11-02 後已輪替，請確認新值

# ============================================
# AI / LLM 提供者 (已移除 Google Gemini/ADK)
# ============================================
MISTRAL_API_KEY=***
MISTRAL_ADMIN_KEY=***
MISTRAL_WORKFLOW_KEY=***
GROQ_API_KEY=***
# 注意：已移除 Google Gemini 配置

# ============================================
# 雲端與服務
# ============================================
CLOUDFLARE_API_TOKEN=***
VPS_HOST=your-vps-host
VPS_USER=your-vps-user
VPS_KEY_PATH=~/.ssh/id_ed25519

# ============================================
# 其他服務
# ============================================
NOTION_WORKSPACE_ID=***
NOTION_API_SECRET=***
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 開發工具
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 注意：本檔案為範例，不應包含真實值
# 所有真實值請移至 .env.local（本機）或 secret-vault/（生產）
