{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "downlevelIteration": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lib/*": [
        "./src/lib/*",
        "./lib/*"
      ],
      "@google/genai": [
        "./src/lib/genai"
      ],
      "@esggo/shared": [
        "./packages/shared/src"
      ],
      "@esggo/shared/*": [
        "./packages/shared/src/*"
      ],
      "@esggo/ui": [
        "./packages/ui/src"
      ],
      "@esggo/ui/*": [
        "./packages/ui/src/*"
      ],
      "@esggo/errors": [
        "./packages/errors/src"
      ],
      "@esggo/errors/*": [
        "./packages/errors/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "incremental": true
  },
  "include": [
    "src/impl/**/*.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "fake_answer_fix.ts",
    "apps/gateway/omni-server.ts",
    "src/lib/omni-agent/**",
    "src/lib/omni-component/**",
    "src/lib/omni-agent-bus.ts",
    "app/api/omni-agent/console/*.ts",
    "app/omni-center/omni-one-chat.tsx",
    "app/omni-center/wuzuo-note-view.tsx",
    "src/lib/celestial/implementation.ts",
    "src/lib/omni-component/**",
    "app/**/*.tsx",
    "app/**",
    "src/**/test-*.ts",
    "src/**/example-*.ts",
    "_fix-backup-20260801/**",
    "_analysis/**",
    "worker/**",
    "vendor/**"
  ]
}
