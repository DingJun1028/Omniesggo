# =============================================================================
# OmniCore V5.1 — 生產環境變數清單
# =============================================================================
# ⚠️  此檔案為範本，不含任何真實值
# ⚠️  複製為 .env.production 並填入實際值後，切勿提交至 Git
# =============================================================================

# ── 應用設定 ────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=                   # 必填：公開網域 (e.g. https://omnicore.example.com)
PORT=3000

# ── AI 模型 API ──────────────────────────────────────────────────────────────
FREE_TIER_ONLY=true                    # 必填：設為 true 強制使用免費層 AI 模型 (預設為 true 以防爆帳單)


AGNES_API=                             # 必填：AGNES API Key (alias for Gemini)
NEXT_PUBLIC_AGNES_API_KEY=             # 必填：公開端 Gemini Key
NVAPI_KEY=                             # 選填：NVIDIA API Key

# ── 資料庫 ──────────────────────────────────────────────────────────────────
DATABASE_URL=                          # 必填：PostgreSQL 連線字串 (postgres://user:pass@host:5432/db?sslmode=require)
DIRECT_URL=                            # 選填：Prisma Direct URL (for migrations)

# ── Redis 快取 ───────────────────────────────────────────────────────────────
REDIS_URL=                             # 必填：Redis 連線字串 (redis://user:pass@host:6379)
UPSTASH_REDIS_REST_URL=                # 選填：Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=              # 選填：Upstash Redis Token

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=              # 必填：Supabase 專案 URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # 必填：Supabase Anon Key (公開)
SUPABASE_SERVICE_ROLE_KEY=             # 必填：Supabase Service Role Key (後端僅用，絕不公開)


# ── OmniCore 授權 ────────────────────────────────────────────────────────────
OMNI_KEY=                              # 必填：OmniCore 最高層授權金鑰 (JunAiKey)
OMNI_SOUL_SEED=                        # 選填：Soul 語意種子

# ── 內部服務金鑰（路由守門）─────────────────────────────────────────────────
CRON_SECRET=                           # 選填：/api/cron POST 手動觸發守門（未設則退回 x-user-id 內部上下文）
MEMORY_API_KEY=                        # 選填：/api/memory POST/DELETE 寫入守門（未設則退回 x-user-id 內部上下文）

# ── Notion Worker ────────────────────────────────────────────────────────────
NOTION_WORKSPACE_ID=                   # 選填：Notion Workspace ID (ntn login 後取得)
NOTION_API_SECRET=                     # 選填：Notion Internal Integration Secret

# ── 監控與可觀測性 ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=           # 選填：OpenTelemetry Collector Endpoint
OTEL_SERVICE_NAME=omnicore             # 選填：服務名稱標籤

# ── VPS / 部署 ───────────────────────────────────────────────────────────────
VPS_HOST=                              # 選填：VPS 主機 IP/Domain
VPS_SSH_PORT=22                        # 選填：SSH 端口
VPS_DEPLOY_PATH=/var/www/omnicore      # 選填：遠端部署路徑
