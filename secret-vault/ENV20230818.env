# ============================================
# Omniesggo 機密聖櫃 (Secret Vault)
# 主要憑證存放位置
# 檔案權限：600（僅所有者可讀寫）
# 絕對不要提交到版本控制
# ============================================

# JunAikey 萬能元鑰
# 讀取方式：read_file(secret-vault/ENV20230818.env)
NCBDB_API_TOKEN=your_actual_ncbdb_token_here
NCBDB_PROJECT_ID=your_project_id_here

# JunAikey 成長層 CLI
JUNAKEY_BACKEND=local
JUNAKEY_CLI=scripts/junaikey.mjs

# OmniMasterKey 憑證存取
OMNIMASTER_KEY=your_omni_master_key_here

# LLM / AI API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_ADMIN_KEY=your_mistral_admin_key_here
MISTRAL_WORKFLOW_KEY=your_mistral_workflow_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=***
ANTHROPIC_API_KEY=***
GOOGLE_API_KEY=***
HF_TOKEN=your_hf_token_here

# 雲端服務
CLOUDFLARE_API_TOKEN=***
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
VPS_HOST=your_vps_host_here
VPS_USER=your_vps_user_here
VPS_KEY_PATH=~/.ssh/id_ed25519

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Firebase
FIREBASE_API_KEY=***
FIREBASE_AUTH_DOMAIN=***
FIREBASE_PROJECT_ID=***
FIREBASE_STORAGE_BUCKET=***
FIREBASE_MESSAGING_SENDER_ID=***
FIREBASE_APP_ID=***

# 資料庫連線
DATABASE_URL=your_database_url_here
SUPABASE_TABLE_MAP={"omni_agent":"omni_agent_schema","agent_skills":"agent_skills_schema"}

# 開發工具
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Conduit (VPS 連線)
CONDUIT_HOST=hermex.esggo.co
CONDUIT_USER=hermes
CONDUIT_PASSWORD=your_conduit_password_here
