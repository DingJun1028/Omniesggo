{
  "name": "universal-translator",
  "version": "1.7.0",
  "description": "OA-Team 萬能即時翻譯服務 (LibreTranslate → MyMemory → 原文兜底) + Ollama+Gemma 選用 + 繁中英碼終始矩陣",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "health": "curl -sf http://localhost:8788/health",
    "sync:lang": "node ../../scripts/sync-lang-matrix.mjs",
    "types-sync": "node ../../scripts/sync-lang-matrix.mjs --check",
    "predeploy": "node ../../scripts/sync-lang-matrix.mjs",
    "test": "node --test test/*.test.mjs",
    "sonar:analyze": "sonar analyze agentic --staged",
    "sonar:issues": "sonar list issues --project universal-translator --format toon",
    "sonar:remediate": "sonar remediate --project universal-translator"
  },
  "dependencies": {
    "ws": "^8.22.2"
  }
}
