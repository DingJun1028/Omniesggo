# ============================================================
# 萬能藍圖中心 (Omni-Blueprint Hub) — 環境變數範本
# 複製為 .env 後由 ecosystem.config.cjs 載入；.env 已被 .gitignore 排除
# ============================================================

# --- 伺服器 ---
PORT=8787                      # 監聽埠 (本機煙霧測試建議 8799 避免衝突)
REPLAY_MAX=20                  # 新訂閱者可回補的近期事件數 (事件回放環形緩衝)
RATE_MAX=60                    # 每 IP 每分鐘寫入次數上限 (/ingest, /speak)

# --- 認證 (留空 = 不啟用；生產建議設定) ---
# 設定後 /ingest 與 /speak 需帶 ?token=... 或 Authorization: Bearer ...
INGEST_TOKEN=

# --- 多語翻譯 ---
LANG_TARGETS=zh-CN,en,ja,es,ko,fr   # 廣播目標語系 (逗號分隔)
LANG_DEFAULT=en                     # 講者端未指定時的來源語

# --- 翻譯引擎 (優先序: LibreTranslate → MyMemory → 原文兜底) ---
# 設定 LIBRETRANSLATE_URL 即啟用自建引擎，未設則走 MyMemory 免費端點 (零 key)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=
TRANSLATE_TIMEOUT_MS=8000
TRANSLATE_RETRIES=2
TRANSLATE_CACHE_MAX=1000

# --- 本機字幕抓取 (captions-scraper，VPS 無 chromium 時由本機推送) ---
CHROME_BIN=
INGEST_URL=https://live.esggo.co/ingest

# --- 部署 (deploy.sh) ---
DEPLOY_HOST=ubuntu@161.118.248.180
DEPLOY_PATH=/opt/esggo/apps/omni-blueprint-hub
DEPLOY_KEY=~/.ssh/esggo_original
DEPLOY_PM2_NAME=omni-blueprint-hub
DEPLOY_PUBLIC_BASE=https://live.esggo.co

# --- Telegram Bot (可選) ---
# 打開 @BotFather 發送 /newbot，複製產生的 HTTP API token
# 設定後機器人可接收入站文字、圖片、檔案（附帶說明文字或不帶）
# 託管版 Bot API 單個附件下載上限 20 MB
TELEGRAM_BOT_TOKEN=

# --- LangSmith 鏈路追蹤 ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=esggo

# --- Langfuse 鏈路追蹤 ---
# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-...xxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
