# ═════════════════════════════════════════════════════════════════════════════
# TDAI 全域性映象本地部署 - 環境變數模板
#
# 用法：
#   cp .env.example .env
#   # 編輯 .env，把 REPLACE_ME 換成你自己的值
#   ./start-all.sh
#
# 兩組獨立引數：
#   MEMORY_*   → memory + memory-hub 使用（內部記憶/知識服務的 LLM）
#   PROXY_*    → proxy 使用（使用者請求轉發到的上游 LLM）
# 兩組值可以相同，也可以指向完全不同的模型/供應商。
# ═════════════════════════════════════════════════════════════════════════════

# ── 映象 tag ─────────────────────────────────────────────────────────────────
# 預設走 Docker Hub 公開映象（多架構 amd64 + arm64，docker pull 無需登入）：
#   https://hub.docker.com/r/agentmemory/memory-core
#   https://hub.docker.com/r/agentmemory/memory-proxy
#   https://hub.docker.com/r/agentmemory/memory-hub
# 想固定版本時把 :latest 換成具體版本，例如 :1.0.0-beta.1。
# 注意：本地已存在同名 :latest 時指令碼會直接複用，不會自動感知遠端更新。
# 想拉最新的一版，用 `PULL=1 ./start-all.sh`。
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── 騰訊內網備選（內部同事用） ────────────────────────────────────────────────
# 內部環境（騰訊辦公網/devcloud）可以覆蓋成 mirrors.tencent.com 私倉，無需
# 走公網 Docker Hub。使用前先 `docker login mirrors.tencent.com`。
# MEMORY_CORE_IMAGE=mirrors.tencent.com/memory-team-control/memory-core:latest
# MEMORY_HUB_IMAGE=mirrors.tencent.com/memory-team-control/memory-hub:latest
# PROXY_IMAGE=mirrors.tencent.com/memory-team-control/proxy:latest

# ── memory 組：memory + memory-hub 內部呼叫的 LLM ────────────────────────────
# 用途：memory 的 embed/summarize；memory-hub 里 knowledge 的 wiki ingest / 總結
MEMORY_LLM_BASE_URL=REPLACE_ME              # 例：https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # 例：sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # 例：deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── proxy 組：proxy 把使用者請求轉發到的上游 LLM ──────────────────────────────
# 用途：coding agent / 客戶端調 proxy:8096，proxy 再轉發到這裡
PROXY_UPSTREAM_URL=REPLACE_ME               # 例：https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # 例：sk-xxxxxxxx（可與 memory 組不同）
PROXY_UPSTREAM_MODEL=REPLACE_ME             # 例：deepseek-chat

# ── 埠（預設可直接用；有本地衝突時改這裡） ───────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── knowledge 外部可達地址（memory-hub 需要）─────────────────────────────────
# 讓 agent / gateway 能訪問到 KS 的 tools 介面。必須含 /v3 字首。
# 本地場景預設用 host.docker.internal 讓容器內可迴環到宿主。
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── Panel UI "客戶端接入地址" 卡片顯示的 base URL（開源本地部署專用）──────────
# 開源部署 core 和 proxy 分開跑，coding agent 客戶端要接的是 proxy，不是 core/gateway。
# 該值僅供 Panel UI 拼接展示用（如 CodeBuddy / ClaudeCode 的 baseUrl 複製卡片），
# Panel 後端 → Kernel 的轉發始終走 REMOTE_INSTANCE_URL（=memory-core），不受此變數影響。
#
# 未設定時指令碼會自動探測宿主機 LAN IP（`hostname -I` / macOS `ipconfig getifaddr en0`）
# 並拼成 `http://<lan-ip>:${PROXY_PORT}` —— 別人的電腦直接拷卡片里的 URL 就能連過來。
# 顯式留空（=""）則回落到 gateway_endpoint 老行為。
# 想顯式指定（比如公網域名 / 特定網絡卡 IP）就取消下面這行註釋填真值：
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096

# ── 資料卷名 ─────────────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── memory-core 內部憑據 ─────────────────────────────────────────────────────
# Gateway 的 Bearer 層管理憑據。
#   留空（預設）   —— 關閉 Bearer gate（本地零配置體驗；proxy 的 auth/sessionInit
#                    僅在此配置下能與 memory-core 直連，見 start-memory-core.sh 頂部註釋）
#   非空          —— 所有請求必須帶 `Authorization: Bearer <key>`；proxy 目前
#                    不發這個 header，因此 proxy 的 auth/sessionInit 會失敗
# 生產環境後續需在 proxy 側修復后再啟用非空 key。
MEMORY_CORE_GATEWAY_API_KEY=

# admin 使用者名稱（首次 init-admin 用）。user_key 由指令碼首次啟動自動生成一把隨機 sk-mem-
# 存到 ./.admin-key —— 後續指令碼 / claude-proxy 從此檔案讀取，不再需要手工填寫。
MEMORY_CORE_ADMIN_USERNAME=admin
