# =============================================================================
# ESG GO — ARM64 Multi-Stage Docker Build
# Platform: linux/arm64 (Oracle Cloud Ampere A1 / Apple Silicon)
# =============================================================================

FROM --platform=linux/arm64 node:22-alpine AS deps
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache libc6-compat build-base python3
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/omni-agent-bus/package.json packages/omni-agent-bus/
COPY packages/oa-framework/package.json packages/oa-framework/
COPY packages/omni-agent/package.json packages/omni-agent/
COPY packages/shared/package.json packages/shared/
COPY packages/cli/package.json packages/cli/
COPY packages/capacities/package.json packages/capacities/
COPY packages/errors/package.json packages/errors/
COPY packages/ui/package.json packages/ui/
COPY libs/incremental/package.json libs/incremental/
COPY apps/ftg-tools/package.json apps/ftg-tools/
COPY apps/omni-factory/package.json apps/omni-factory/
COPY apps/omnilive/package.json apps/omnilive/
COPY apps/ftg-journey-web/package.json apps/ftg-journey-web/
COPY apps/universal-translator/package.json apps/universal-translator/
COPY apps/omni-cli/package.json apps/omni-cli/
COPY apps/omni-api/package.json apps/omni-api/
COPY apps/self-healing/package.json apps/self-healing/
COPY apps/evolution-engine/package.json apps/evolution-engine/
COPY apps/omni-blueprint-hub/package.json apps/omni-blueprint-hub/
COPY apps/ftg-journey-server/package.json apps/ftg-journey-server/
COPY apps/gateway/package.json apps/gateway/
COPY apps/learning-center/package.json apps/learning-center/
COPY apps/ftg-tours-website/package.json apps/ftg-tours-website/
COPY apps/cf-tunnel-manager/package.json apps/cf-tunnel-manager/
COPY apps/oneringai/package.json apps/oneringai/
COPY cli/omnicli/package.json cli/omnicli/
COPY cli/esggo-cli/package.json cli/esggo-cli/
COPY cli/oa-cli/package.json cli/oa-cli/
COPY apps/learning-center/functions/package.json apps/learning-center/functions/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM --platform=linux/arm64 node:22-alpine AS builder
WORKDIR /app
RUN apk upgrade --no-cache && npm install -g pnpm && rm -rf /var/cache/apk/*
COPY . .
COPY --from=deps /app/node_modules ./node_modules
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production CI=true
# Build-time placeholder ONLY. scripts/validate-env.ts requires DATABASE_URL to be
# non-empty (presence check, no URL validation). This builder stage is discarded —
# the runner below is a fresh FROM — so the real DATABASE_URL is still injected at
# runtime by docker-compose / pm2 env and is never baked into the shipped image.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npx prisma generate
RUN pnpm run build

FROM --platform=linux/arm64 node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 CI=true
# Install runtime deps with security hardening
RUN apk add --no-cache libssl3 ca-certificates && rm -rf /var/cache/apk/*
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
RUN chown -R nextjs:nodejs /app
USER nextjs
EXPOSE 3000
LABEL org.opencontainers.image.title="esggo" \
      org.opencontainers.image.description="ESG GO Next.js application (ARM64)" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="ESG GO" \
      org.opencontainers.image.licenses="AGPL-3.0"
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
