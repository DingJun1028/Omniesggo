# =============================================================================
# ESG GO — ARM64 Multi-Stage Docker Build
# Platform: linux/arm64 (Oracle Cloud Ampere A1 / Apple Silicon)
# 2026-10-27 De-Prisma：移除 npx prisma generate（Supabase 相容層無需 generate）
# =============================================================================

FROM --platform=linux/arm64 node:22-alpine AS deps
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache libc6-compat build-base python3
RUN npm install -g pnpm@11.5.2
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/errors/package.json packages/errors/
COPY apps/oneringai/package.json apps/oneringai/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM --platform=linux/arm64 node:22-alpine AS builder
WORKDIR /app
RUN apk upgrade --no-cache && npm install -g pnpm@11.5.2 && rm -rf /var/cache/apk/*
COPY . .
COPY --from=deps /app/node_modules ./node_modules
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production CI=true
# Build-time placeholder ONLY. scripts/validate-env.ts requires DATABASE_URL to be
# non-empty (presence check, no URL validation). This builder stage is discarded —
# the runner below is a fresh FROM — so the real DATABASE_URL is still injected at
# runtime by docker-compose / pm2 env and is never baked into the shipped image.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN pnpm run build

FROM --platform=linux/arm64 node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 CI=true
# Install runtime deps with security hardening
RUN apk add --no-cache libssl3 ca-certificates && rm -rf /var/cache/apk/*
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
RUN chown -R nextjs:nodejs /app
USER nextjs
EXPOSE 3000
LABEL org.opencontainers.image.title="esggo" \
      org.opencontainers.image.description="ESG GO Next.js application (ARM64)" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="ESG GO" \
      org.opencontainers.image.licenses="AGPL-3.0"
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
